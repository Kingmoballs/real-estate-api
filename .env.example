NODE_ENV=development
PORT=5000

# Database and cache
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
REDIS_URL=redis://localhost:6379

# Authentication - use long, independently generated secrets
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Use a comma-separated list when more than one frontend is allowed
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email
RESEND_API_KEY=
# Resend testing sender; replace after verifying a production domain
EMAIL_FROM="Real Estate Platform <onboarding@resend.dev>"
EMAIL_REPLY_TO=
# Full frontend page that accepts a token query parameter
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Booking rules
PENDING_BOOKING_TIMEOUT_HOURS=48
PAYMENT_TIMEOUT_HOURS=24
REUPLOAD_TIMEOUT_HOURS=24

# Initial admin seed
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
